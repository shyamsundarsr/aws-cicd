{
  "family": "petclinic-backend",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::261371110333:role/ecs_task_execution_role",
  "containerDefinitions": [
    {
      "name": "petclinic-backend",
      "image": "261371110333.dkr.ecr.us-east-1.amazonaws.com/petclinic-backend:latest",
      "cpu": 256,
      "memory": 1024,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 9966,
          "hostPort": 9966,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "postgres,spring-data-jpa" }
      ],
      "secrets": [
        {
          "name": "POSTGRES_URL",
          "valueFrom": "petclinic/backend-env:POSTGRES_URL::"
        },
        {
          "name": "POSTGRES_USER",
          "valueFrom": "petclinic/backend-env:POSTGRES_USER::"
        },
        {
          "name": "POSTGRES_PASS",
          "valueFrom": "petclinic/backend-env:POSTGRES_PASS::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/petclinic-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}